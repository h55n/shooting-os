NEXT_PUBLIC_APP_NAME=Shooting OS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth UUID for the sole owner. Never prefix this with NEXT_PUBLIC_.
OWNER_USER_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Ordered server-side AI fallback chain, for example: groq,mistral,nvidia.
AI_PROVIDER=groq
AI_FALLBACK_PROVIDERS=mistral,nvidia
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
CRON_SECRET=
# False in hosted environments. Keep true only for local demo-only work.
NEXT_PUBLIC_DEMO_MODE=false
